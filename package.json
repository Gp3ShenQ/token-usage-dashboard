{
  "name": "token-usage-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Local Electron dashboard for Claude Code and Codex token usage",
  "author": "Gp3ShenQ",
  "main": "dist-electron/electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:main\" \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.node.json --watch --preserveWatchOutput",
    "dev:electron": "wait-on tcp:5173 dist-electron/electron/main.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron dist-electron/electron/main.js",
    "build": "npm run build:renderer && npm run build:main && electron-builder --win portable --publish never",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.node.json",
    "typecheck": "vue-tsc --noEmit",
    "test:monitor": "vitest run --config vitest.config.ts",
    "monitor:install": "node scripts/install-monitor.mjs --apply",
    "test:monitor-ui": "electron scripts/check-monitor-ui.cjs"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "better-sqlite3": "^11.7.0",
    "dayjs": "^1.11.13",
    "echarts": "^5.5.1",
    "fastify": "^5.1.0",
    "glob": "^11.0.1",
    "pinia": "^3.0.3",
    "vue": "^3.5.13",
    "vue-echarts": "^7.0.3",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/tsconfig": "^0.7.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.2.0",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.gp3shenq.token-usage-dashboard",
    "productName": "Token Usage Dashboard",
    "icon": "public/app-icon.ico",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!dist-electron/**/__tests__/**"
    ],
    "portable": {
      "artifactName": "token-usage-dashboard-portable.exe"
    },
    "win": {
      "icon": "public/app-icon.ico",
      "signAndEditExecutable": false,
      "target": [
        "portable"
      ]
    }
  }
}
